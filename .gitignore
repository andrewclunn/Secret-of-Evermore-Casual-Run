# Only Build and Screenshots are included among top-level folders.
/*/
!/Build/
!/Screenshots/

# Generated ROMs stay local; distribute versioned IPS patches instead.
**/*.sfc
**/*.smc
**/*.pyc
**/*.py
__pycache__/

# Keep the third-player proof-of-concept build and verification scripts.
!Build/build.py
!Build/ShadowPrototype/*.py
!Build/VisualPrototype/*.py
!Build/GrowthPrototype/*.py
